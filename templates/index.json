          "settings": {
            "avatar": "shopify://shop_images/review1.png",
            "star": 5,
            "title": "CUSTOMER REVIEWS",
            "info_other": "Emily R. - From USA",
            "quote": "<p>My golden retriever absolutely loves his new cozy cave bed! He used to pace around at night, but now he curls right in and sleeps through till morning. Worth every penny!</p>"
          }
        },
        "quote_GVmddR": {
          "type": "quote",
