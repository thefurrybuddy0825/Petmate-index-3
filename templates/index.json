            "star": 5,
            "title": "CUSTOMER REVIEWS",
            "info_other": "Daniel K. - From Canada",
            "quote": "<p>The stainless steel bowls are not only sturdy but also super easy to clean. I appreciate the quality — feels much better than anything I bought from a big box store.</p>"
          }
        },
        "quote_PycBJt": {
          "type": "quote",
          "settings": {
