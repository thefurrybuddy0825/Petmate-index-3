<style>
  .header-top {
    background-color: rgba({{ sst.bg_t | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, {{ sst.bg_t_opacity }}%);
    color: {{ sst.c_t }};
  }
  .header-contact i {
    color:  {{ sst.c_ti }};
  }
  .header-top .dropdown button {
    color: {{ sst.c_t }};
  }
  .WishlistCount, .site-header__cart .site-header__cart-count, .header-mobile .mobile_cart .cart-count {
    background: {{ sst.bg_count }};
    color:  {{ sst.c_count }};
  }
  {% if sst.phone != blank %}
    .header-call, .header-call a {
      color: {{ sst.phone_c }};
    }
  {% endif %}
  .template-index .header-center {
    background-color: rgba({{ sst.bg_c | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, {{ sst.bg_c_opacity }}%);
  }
  body:not(.template-index) .header-center {
    background-color: rgba({{ sst.bg_c_inner | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, {{ sst.bg_c_opacity_inner }}%);
  }
  .site-header .header-icon, .site-nav--btn {
    color: {{ sst.c_ci }} !important;
  }
  {% if sst.bd_ci != blank %}
    .header-icon {
      background-image: url("data:image/svg+xml,%3csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3e%3crect width='100%25' height='100%25' fill='none' rx='15' ry='15' stroke='%23{{ sst.bd_ci | remove: '#' }}' stroke-width='2' stroke-dasharray='4%2c 4%2c 4' stroke-dashoffset='0' stroke-linecap='butt'/%3e%3c/svg%3e");
    }
  {% endif %}
  {% if sst.bd_cih != blank %}
    .header-icon:hover {
      background-image: url("data:image/svg+xml,%3csvg width='100%25' height='100%25' xmlns='http://www.w3.org/2000/svg'%3e%3crect width='100%25' height='100%25' fill='none' rx='15' ry='15' stroke='%23{{ sst.bd_cih | remove: '#' }}' stroke-width='2' stroke-dasharray='4%2c 4%2c 4' stroke-dashoffset='0' stroke-linecap='butt'/%3e%3c/svg%3e");
    }
  {% endif %}
  .header-mobile, .header-mobile .header-mobile-content {
    background-color: {{ sst.bg_m }};
  }
  .mobile_cart .site-header__cart-icon, .btn-vertical_sm, .header-mobile .mobile-btn_search.act i {
    color: {{ sst.c_icon_m }};
  }
  .header-mobile .icon-directional, #show-megamenu:before, #show-megamenu:after {
    background-color: {{ sst.c_icon_m }};
  }
  {% if sst.bd_b_sm %}
    .header-mobile {
      border-bottom: 1px solid {{ sst.bd_c_sm }};
    }
  {% endif %}
  #header-sticky {
    background-color: rgba({{ sst.bg_sticky | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, {{ sst.bg_sticky_opacity }}%);
  }
  #header-sticky .header-icon {
    color: {{ sst.c_i_sticky }} !important;
  }
  .site-header__logo-image {
    max-width: {{ sst.wm_logo }}px;
  }
  .contentsticky_logo {
    background-color: {{ sst.bg_logo }};
  }
</style>