{%- assign sst = section.settings -%}
<div class="distance{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate == true %} wow fadeInUp animated{% endif %}">
  {% if sst.heading != blank or sst.subheading != blank %}
    <div class="title_section {{ sst.title_alignment }}">
      {% if sst.subheading != blank %}
      <span class="sub_title" style="color: {{ sst.subheading_c }};">{{ sst.subheading }}</span>
    {% endif %}
    {% if sst.heading != blank %}
    <span class="title" style="color: {{ sst.heading_c }};">{{ sst.heading }}</span>
    {% endif %}
    </div>
  {% endif %}
  <div class="block-content position-relative pb-75">
    {% if sst.wave %}
      <div class="wave position-absolute overfow_hidden">
        <svg viewBox="0 0 500 150" preserveAspectRatio="none" style="height: 100%; width: 100%;">
          <path d="M-0.84,148.53 C222.06,-48.83 270.59,-50.80 503.10,151.48 L500.00,0.00 L0.00,0.00 Z" style="stroke: none; fill: {{ sst.wave_bg }};"></path>
        </svg>
      </div>
    {% endif %}
    <div class="container">
      <div class="block-service row position-relative">
        {% for block in section.blocks %}
          {%- assign bst = block.settings -%}
          <div class="sv-item text-center col-sm col-6">
            {% if bst.image != blank %}
            <div class="item-image d-inline-block">
              <img data-src="{{ bst.image | img_url: '190x190', crop: 'center' }}" class="lazyload" alt="{{ bst.image.alt }}">
            </div>
            {% endif %}
            <div class="item-title font-700 mt-25">
            {% if bst.link != blank %}<a href="{{ bst.link }}" class="hover:c_df">{% endif %}{{ bst.title }}{% if bst.link != blank %}</a>{% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="row">
        <div class="col-xl-7 col-lg-6 mb-md-30">
          {% if sst.title != blank or sst.subtitle != blank %}
            <div class="title_section">
              {% if sst.title != blank %}
                <span class="title" style="color: {{ sst.title_c }};">{{ sst.title }}</span>
              {% endif %}
              {% if sst.subtitle != blank %}
                <span class="desc mt-15 d-block" style="color: {{ sst.subtitle_c }};">{{ sst.subtitle }}</span>
              {% endif %}
            </div>
          {% endif %}
          {% if sst.phone != blank %}
            <div class="item-contact d-flex align-items-center p">
                <i class="rbb-icon-phone-2"></i>
                <span class="phone font-700">{{ sst.phone }}</span>
            </div>
          {% endif %}
          {% if sst.email != blank %}
            <div class="item-contact d-flex align-items-center mt-10">
              <i class="rbb-icon-email-10"></i>
              <span>{{ sst.email }}</span>
            </div>
          {% endif %}
          {% if sst.open != blank %}
            <div class="item-contact d-flex align-items-center mt-10">
              <i class="rbb-icon-time-2"></i>
              <span>{{ sst.open }}</span>
            </div>
          {% endif %}
        </div>
        <div class="col-xl-5 col-lg-6">
          <div class="block-form-contact position-relative{% if sst.bg_i != blank %} has-img{% endif %}">
            {% form 'contact', id: section.id %}
              {% if form.posted_successfully? %}
                <p class="note form-success">
                  {{ 'page.contact.form.post_success' | t }}
                </p>
              {% endif %}
              
              {{ form.errors | default_errors }}
              
              <input type="text" id="ContactFormName" name="contact[name]" value="{% if form[name] %}{{ form[name] }}{% elsif customer %}{{ customer.name }}{% endif %}" class="mb-10 rounded-pill {% if form.errors contains 'name' %}input--error{% endif %}" placeholder="{{ 'page.contact.form.name' | t }}" required>
              <input type="email" id="ContactFormEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" class="mb-10 rounded-pill {% if form.errors contains 'email' %}input--error{% endif %}" placeholder="{{ 'page.contact.form.email' | t }}" required>
              <input type="tel" id="ContactFormPhone" name="contact[phone]" pattern="[0-9\-]*" value="{% if form[phone] %}{{ form[phone] }}{% elsif customer %}{{ customer.phone }}{% endif %}" class="mb-10 rounded-pill {% if form.errors contains 'phone' %}input--error{% endif %}" placeholder="{{ 'page.contact.form.phone' | t }}">
              {% if section.blocks.size > 0 %}
                <select id="services" name="contact[services]" class="mb-10 rounded-pill" required>
                  <option disabled hidden selected value="">Services Request</option>
                  {% for block in section.blocks %}
                    <option value="{{ block.settings.title }}">{{ block.settings.title }}</option>
                  {% endfor %}
                </select>
              {% endif %}
              <textarea rows="12" cols="50" id="ContactFormMessage" class="mb-20" name="contact[body]" placeholder="{{ 'page.contact.form.message' | t }}">{% if form.body %}{{ form.body }}{% endif %}</textarea>
              
              <button class="btn bg_df white hover:bg_pr w-100" type="submit">
                <span>{{ 'contact.form.submit' | t }}</span>
              </button>
            {% endform %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Contact",
    "class": "section-contact",
    "max_blocks": 4,
    "settings": [
      {
        "type": "header",
        "content": "Heading"
      },
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Contact</p>"
      },
      {
        "type": "color",
        "id": "heading_c",
        "label": "Heading color",
        "default": "#222222"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subheading_c",
        "label": "Sub heading color",
        "default": "#666666"
      },
      {
        "type": "select",
        "id": "title_alignment",
        "label": "Heading alignment",
        "default": "text-center",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type": "header",
        "content": "Block services"
      },
      {
        "type": "color",
        "id": "sv_bd_color",
        "label": "Image border color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "sv_title_c",
        "label": "Title color",
        "default": "#222222"
      },
      {
        "type": "header",
        "content": "Block info"
      },
      {
        "type": "richtext",
        "id": "title",
        "label": "Title",
        "default": "<p>Vinova Contact</p>"
      },
      {
        "type": "color",
        "id": "title_c",
        "label": "Title color",
        "default": "#222222"
      },
      {
        "type": "richtext",
        "id": "subtitle",
        "label": "Sub title",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subtitle_c",
        "label": "Sub title color",
        "default": "#666666"
      },
      {
        "type": "inline_richtext",
        "id": "phone",
        "label": "Contact phone",
        "default": "0123 456 789"
      },
      {
        "type": "inline_richtext",
        "id": "email",
        "label": "Contact email",
        "default": "demo@gmail.com"
      },
      {
        "type": "inline_richtext",
        "id": "open",
        "label": "Contact open",
        "default": "Monday till Friday 10 to 6 EST"
      },
      {
        "type": "color",
        "id": "text_c",
        "label": "Text color",
        "default": "#666666"
      },
      {
        "type": "color",
        "id": "icon_c",
        "label": "Icon color",
        "default": "#666666"
      },
      {
        "type":  "header",
        "content": "Form contact"
      },
      {
        "type": "color",
        "id": "bg_form",
        "label": "Background",
        "default": "#5f5f5f"
      },
      {
        "type": "color",
        "id": "bd_c",
        "label": "Border color",
        "default": "#5f5f5f"
      },
      {
        "type": "range",
        "id": "bg_p",
        "min": -30,
        "max": 30,
        "step": 5,
        "unit": "%",
        "label": "Background position desktop",
        "default": 0
      },
      {
        "type":  "header",
        "content": "Design option"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default":   true
      },
      {
        "type": "checkbox",
        "id": "wave",
        "label": "Show wave bottom"
      },
      {
        "type": "color",
        "id": "wave_bg",
        "label": "Background wave",
        "default": "#ffffff"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "number",
        "id": "distance_top",
        "label": "Top spacing section (px)",
        "default": 30
      },
      {
        "type": "number",
        "id": "distance_bottom",
        "label": "Bottom spacing section (px)",
        "default": 30
      }
    ],
    "blocks": [
      {
        "type": "services",
        "name": "Services",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Services",
            "default": "Services"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [{
      "name": "Vinova Contact",
      "category": "Promotional",
      "blocks": [
        {
          "type": "services"
        },
        {
          "type": "services"
        },
        {
          "type": "services"
        }
      ]
    }]
  }
{% endschema %}
{%- assign bg_image = sst.background_image -%}
<style>
  #shopify-section-{{ section.id }} .distance {
    padding-top: {{ sst.distance_top | append: 'px' }};
    padding-bottom: {{ sst.distance_bottom | append: 'px' }}; 
  }
  @media(max-width: 991px) {
    #shopify-section-{{ section.id }} .distance {
      {%- if sst.distance_top > 20 -%}padding-top: {{ sst.distance_top | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
      {%- if sst.distance_bottom > 20 -%}padding-bottom: {{ sst.distance_bottom | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
    }
  }
  #shopify-section-{{ section.id }} .block-content {
    {%- if bg_image.src != blank -%}background-image: url("{{ bg_image | img_url: '1920x' }}");background-position: bottom center;background-repeat: no-repeat;background-size: cover;{%- endif -%}
  }
  #shopify-section-{{ section.id }} .block-form-contact {
    background-color: {{ sst.bg_form }};
    border-color: {{ sst.bd_c }};
  }
  #shopify-section-{{ section.id }} .item-contact span {
    color:  {{ sst.text_c }};
  }
  #shopify-section-{{ section.id }} .item-contact i {
    color:  {{ sst.icon_c }};
  }
  {% if section.blocks.size > 0 %}
    #shopify-section-{{ section.id }} .item-image img {
      border-color:  {{ sst.sv_bd_color }};
    }
    #shopify-section-{{ section.id }} .item-title, #shopify-section-{{ section.id }} .item-title a {
      color:  {{ sst.sv_title_c }};
    }
  {% endif %}
  @media(min-width:  992px) {
    #shopify-section-{{ section.id }} .block-form-contact img {
      margin-left: {{ sst.bg_p }}%;
    }
  }
</style>
