{% comment %} === FAQ Accordion Section === {% endcomment %}
{% liquid
  assign show = section.settings.is_show | downcase | strip
%}

{% if show == 'true' or show == '' or show == '1' or show == 'yes' %}
  {%- style -%}
    /* Section-scoped spacing using the section id */
    #shopify-section-{{ section.id }} .faq-accordion-wrap {
      padding-left: {{ section.settings.px | default: 0 }}px;
      padding-right: {{ section.settings.px | default: 0 }}px;
      background-color: {{ section.settings.background_color }};
      {% if section.settings.gradient != blank %}
        background: {{ section.settings.gradient }};
      {% endif %}
      {% if section.settings.background_image != blank %}
        background-image: url({{ section.settings.background_image | image_url }});
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
      {% endif %}
    }

    /* Vertical spacing top/bottom (responsive) */
    #shopify-section-{{ section.id }} .faq-accordion-pad {
      padding-top: {{ section.settings.distance_top_xs | default: 30 }}px;
      padding-bottom: {{ section.settings.distance_bottom_xs | default: 30 }}px;
    }
    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .faq-accordion-pad {
        padding-top: {{ section.settings.distance_top_md | default: 30 }}px;
        padding-bottom: {{ section.settings.distance_bottom_md | default: 30 }}px;
      }
    }
    @media (min-width: 992px) {
      #shopify-section-{{ section.id }} .faq-accordion-pad {
        padding-bottom: {{ section.settings.distance_bottom_lg | default: 30 }}px;
      }
    }
    @media (min-width: 1200px) {
      #shopify-section-{{ section.id }} .faq-accordion-pad {
        padding-top: {{ section.settings.distance_top_xl | default: 30 }}px;
        padding-bottom: {{ section.settings.distance_bottom_xl | default: 30 }}px;
      }
    }

    /* Base styles you already had */
    #shopify-section-{{ section.id }} .accordion { margin: 0 !important; }

    #shopify-section-{{ section.id }} .faq-accordion .faqs-main {
      position: relative;
      border-bottom: 1px solid rgba(var(--color-foreground), 0.16);
      padding: {{ section.settings.spacing | default: 30 }}px 0; /* spacing between items */
    }
    #shopify-section-{{ section.id }} .faq-accordion .faqs-main:last-child { border-bottom: none; }

    /* GPU-friendly underline bar */
    #shopify-section-{{ section.id }} .faq-accordion .faqs-main::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 0;
      height: 3px;
      width: 200px;
      background: #222222;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 1s ease;
      z-index: 1;
    }
    #shopify-section-{{ section.id }} .faq-accordion .faqs-main.active::before {
      transform: scaleX(1);
    }

    /* Header row */
    #shopify-section-{{ section.id }} .faq-accordion .panel-header {
      display: flex;
      align-items: center;
      width: 100%;
      text-align: left;
      background: transparent;
      border: 0;
      padding: 1.4rem 0;
      margin: 0;
      font-weight: 600;
      font-size: 16px;
      cursor: pointer;
      transition: color 0.25s ease;
      border-top: 1px solid var(--color-border);
    }

    #shopify-section-{{ section.id }} .faq-accordion {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    /* Caret on the right; rotate when open */
    #shopify-section-{{ section.id }} .faq-accordion .panel-header .caret-icon {
      margin-left: auto;
      transition: transform var(--duration-short, 150ms) ease;
    }
    #shopify-section-{{ section.id }} .faq-accordion .panel-header[aria-expanded="true"] .caret-icon { transform: rotate(90deg); }

    /* Collapse animation */
    #shopify-section-{{ section.id }} .faq-accordion .collapse {
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transition: max-height 300ms ease, opacity 250ms ease;
    }
    #shopify-section-{{ section.id }} .faq-accordion .collapse.show { opacity: 1; }

    #shopify-section-{{ section.id }} .faq-accordion .item-content {
      padding: 0 0 1.4rem 0;
      font-size: 16px !important;
      border: none !important;
    }

    /* Heading styles */
    #shopify-section-{{ section.id }} .faq-head {
      margin: 0 0 50px 0;
    }
    #shopify-section-{{ section.id }} .faq-head h2 {
      margin: 0 0 8px 0;
      color: {{ section.settings.heading_color | default: '#222222' }};
    }
    #shopify-section-{{ section.id }} .faq-head .subheading {
      margin: 0 0 20px 0;
      color: {{ section.settings.subheading_color | default: '#666666' }};
    }

    /* Optional “animate” flag adds a subtle fade/slide on appearance */
    {% if section.settings.animate %}
    #shopify-section-{{ section.id }} [data-anim] { opacity: 0; transform: translateY(12px); transition: .4s ease; }
    #shopify-section-{{ section.id }} [data-anim].in { opacity: 1; transform: none; }
    {% endif %}
  {%- endstyle -%}

  <section
    class="faq-accordion-wrap {{ section.settings.container }} {{ section.settings.class }}"
    id="Accordion-{{ section.id }}"
    {% if section.settings.animate %}
      data-anim-root="true"
    {% endif %}
  >
    <div class="faq-accordion-pad">
      {% assign align_class = section.settings.heading_alignment | default: 'text-left' %}
      {% if section.settings.heading != blank or section.settings.subheading != blank %}
        <div
          class="faq-head {{ align_class }}"
          {% if section.settings.animate %}
            data-anim
          {% endif %}
        >
          {% if section.settings.heading != blank %}
            <h2 class="h2">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <div class="subheading rte">{{ section.settings.subheading }}</div>
          {% endif %}
        </div>
      {% endif %}

      <div
        class="accordion faq-accordion"
        {% if section.settings.animate %}
          data-anim
        {% endif %}
      >
        {%- assign mf = product.metafields.custom.product_faqs_accordion -%}
        {%- assign mo = null -%}
        {%- if mf != blank and mf.type contains 'metaobject' -%}
          {%- assign mo = mf.value -%}
        {%- endif -%}

        {%- comment -%} is_show: metaobject first; else parse text "true/false" from block setting {%- endcomment -%}
        {%- assign is_show = null -%}
        {%- if mo and mo.is_show != null -%}{%- assign is_show = mo.is_show -%}{%- endif -%}

        {%- if is_show == true -%}
          {%- assign text_sz = block.settings.font_size | default: 16 -%}
          {%- assign text_col = block.settings.text_color | default: '#000' -%}
          {%- assign icon_px = block.settings.emoji_size | default: text_sz -%}
          {%- assign icon_col = block.settings.emoji_color | default: text_col -%}
          {%- assign retina_w = icon_px | times: 2 -%}

          {%- comment -%} 1) Collect ALL rows into a single array, then render once {%- endcomment -%}
          {%- assign rows = '' | split: ',' -%}
          {%- assign SEP = '|||~SEP~|||' -%}
          {%- assign SINGLE = '|||~SINGLE~|||' -%}

          {%- comment -%} 1a) CUSTOM FIELDS (metaobject) — first {%- endcomment -%}
          {%- for i in (1..5) -%}
            {%- assign question = '' -%}
            {%- assign answer_html = '' -%}
            {%- assign ic = 'e887' -%}
            {%- if mo -%}
              {%- case i -%}
                {%- when 1 -%}
                  {%- assign question = mo.question_1 -%}
                  {%- assign answer = mo.answer_1 -%}
                {%- when 2 -%}
                  {%- assign question = mo.question_2 -%}
                  {%- assign answer = mo.answer_2 -%}
                {%- when 3 -%}
                  {%- assign question = mo.question_3 -%}
                  {%- assign answer = mo.answer_3 -%}
                {%- when 4 -%}
                  {%- assign question = mo.question_4 -%}
                  {%- assign answer = mo.answer_4 -%}
                {%- when 5 -%}
                  {%- assign question = mo.question_5 -%}
                  {%- assign answer = mo.answer_5 -%}
              {%- endcase -%}
              {%- if answer != blank -%}
                {%- assign answer_html = answer | metafield_tag -%}
                {%- if answer_html == blank and answer.value != blank -%}
                  {%- assign answer_html = answer.value -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}

            {%- assign has_any = false -%}
            {%- if question != blank or answer_html != blank -%}{%- assign has_any = true -%}{%- endif -%}

            {%- if has_any -%}
              {%- capture row -%}
              {{ question | replace: SEP, '' }}{{ SEP }}
              {{  answer_html  | replace: SEP, '' }}{{ SEP }}
              {{ ic | replace: SEP, '' }}{{ SEP }}
              {{ '' }}{{ SEP }}{{ '' }}
            {%- endcapture -%}
              {%- assign single = row | split: SINGLE -%}
              {%- assign rows = rows | concat: single -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} 2) Render once from unified `rows` {%- endcomment -%}
          {%- assign rows_trim = rows | join: '' | strip -%}
          {%- if rows_trim != '' -%}
            {%- for row in rows -%}
              {%- assign parts = row | split: SEP -%}
              {%- assign _question_text = parts[0] | default: '' | strip -%}
              {%- assign _answer_text = parts[1] | default: '' -%}
              {%- assign ic = parts[2] | default: '' | strip -%}
              {%- assign img1x = parts[3] | default: '' | strip -%}
              {%- assign img2x = parts[4] | default: '' | strip -%}

              {% if _question_text != '' %}
                {%- comment -%} Build icon HTML: code point (hex/decimal), PUA (needs icon font), or literal emoji; else image {%- endcomment -%}
                {%- assign icon_html = '' -%}
                {%- assign ic_raw = ic | to_s | strip -%}
                {%- assign ic_uc = ic_raw | upcase -%}

                {%- assign is_entity = false -%}
                {%- if ic_uc contains '&#X' or ic_uc contains '&#' -%}
                  {%- assign is_entity = true -%}
                {%- endif -%}

                {%- assign hex_clean = ic_uc
                  | remove: '0'
                  | remove: '1'
                  | remove: '2'
                  | remove: '3'
                  | remove: '4'
                  | remove: '5'
                  | remove: '6'
                  | remove: '7'
                  | remove: '8'
                  | remove: '9'
                  | remove: 'A'
                  | remove: 'B'
                  | remove: 'C'
                  | remove: 'D'
                  | remove: 'E'
                  | remove: 'F'
                -%}
                {%- assign is_hex_candidate = false -%}
                {%- if ic_uc != ''
                  and hex_clean == ''
                  and ic_uc.size >= 2
                  and ic_uc.size <= 6
                  and is_entity == false
                -%}
                  {%- assign is_hex_candidate = true -%}
                {%- endif -%}

                {%- assign dec_clean = ic_uc
                  | remove: '0'
                  | remove: '1'
                  | remove: '2'
                  | remove: '3'
                  | remove: '4'
                  | remove: '5'
                  | remove: '6'
                  | remove: '7'
                  | remove: '8'
                  | remove: '9'
                -%}
                {%- assign is_dec_candidate = false -%}
                {%- if ic_uc != '' and dec_clean == '' and is_entity == false -%}
                  {%- assign is_dec_candidate = true -%}
                {%- endif -%}

                {%- comment -%} If looks like PUA (E000–F8FF), we’ll apply an icon font class/style {%- endcomment -%}
                {%- assign needs_icon_font = false -%}
                {%- if is_hex_candidate -%}
                  {%- assign first_char = ic_uc | slice: 0, 1 -%}
                  {%- if first_char == 'E' or first_char == 'F' -%}
                    {%- assign needs_icon_font = true -%}
                  {%- endif -%}
                {%- endif -%}

                {%- assign extra_font_style = '' -%}
                {%- assign extra_font_class = '' -%}
                {%- if needs_icon_font -%}
                  {%- assign extra_font_style = 'font-family:Material Symbols Outlined, "Material Icons", "Material Icons Outlined", sans-serif;' -%}
                  {%- assign extra_font_class = ' material-symbols-outlined' -%}
                {%- endif -%}

                {%- capture icon_markup -%}
                <span class="faq-title-icon{{ extra_font_class }}" aria-hidden="true"
                      style="font-size:{{ icon_px }}px; color:{{ icon_col }}; line-height:1; display:inline-block; margin-right:8px; {{ extra_font_style }}">
                  {%- if is_entity -%}
                    {{ ic_raw }}
                  {%- elsif is_hex_candidate -%}
                    {{ '&#x' | append: ic_uc | append: ';' }}
                  {%- elsif is_dec_candidate -%}
                    {{ '&#'  | append: ic_uc | append: ';' }}
                  {%- elsif ic_raw != '' -%}
                    {{ ic_raw }}
                  {%- endif -%}
                </span>
              {%- endcapture -%}

                {%- if ic_raw != '' -%}
                  {%- assign icon_html = icon_markup -%}
                {%- elsif img1x != '' or img2x != '' -%}
                  {%- assign img_src = img2x | default: img1x -%}
                  {%- capture icon_html -%}
                  <img
                    src="{{ img_src | escape }}"
                    {% if img1x != '' and img2x != '' %}srcset="{{ img1x | escape }} 1x, {{ img2x | escape }} 2x"{% endif %}
                    alt=""
                    width="{{ icon_px }}" height="{{ icon_px }}"
                    style="display:inline-block; width:{{ icon_px }}px; height:{{ icon_px }}px; object-fit:contain; margin-right:8px;">
                {%- endcapture -%}
                {%- endif -%}

                {%- assign uid = section.id | append: '-u-' | append: block.id | append: '-' | append: forloop.index -%}

                <div class="faqs-main {{ section.settings.width_block }}">
                  <div class="panel-group">
                    <div
                      class="panel-header"
                      aria-controls="faq-{{ section.id }}-{{ block.id }}"
                      data-target="#faq-{{ section.id }}-{{ block.id }}"
                    >
                      {%- assign raw = block.settings.icon | default: '' | strip -%}

                      {%- if block.settings.image != blank -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 32 }}"
                          alt=""
                          class="faq-icon img"
                          width="32"
                          height="32"
                          loading="lazy"
                        >
                      {%- elsif raw != '' -%}
                        {%- assign norm = raw
                          | downcase
                          | remove: 'u+'
                          | remove: '0x'
                          | remove: '&#x'
                          | remove: '&#'
                          | remove: ';'
                          | strip
                        -%}
                        {%- assign HEX = norm | upcase -%}
                        {%- assign _clean = HEX
                          | remove: '0'
                          | remove: '1'
                          | remove: '2'
                          | remove: '3'
                          | remove: '4'
                          | remove: '5'
                          | remove: '6'
                          | remove: '7'
                          | remove: '8'
                          | remove: '9'
                          | remove: 'A'
                          | remove: 'B'
                          | remove: 'C'
                          | remove: 'D'
                          | remove: 'E'
                          | remove: 'F'
                        -%}
                        {%- assign is_hex = false -%}
                        {%- if HEX != '' and _clean == '' -%}
                          {%- assign is_hex = true -%}
                        {%- endif -%}

                        {%- if is_hex -%}
                          <span
                            class="faq-icon"
                            aria-hidden="true"
                            style="
                              font-family:'Material Icons','Material Icons Round','Material Icons Outlined','Material Symbols Outlined',sans-serif;
                              color:{{ section.settings.emoji_color }};
                              font-size:{{ section.settings.emoji_size }}px;
                              line-height:1;
                              display:inline-block;
                            "
                          >
                            {{ '&#x' | append: HEX | append: ';' }}
                          </span>
                        {%- else -%}
                          <span
                            class="faq-icon"
                            aria-hidden="true"
                            style="
                              font-family:'Apple Color Emoji','Segoe UI Emoji','Noto Color Emoji','Noto Emoji','EmojiOne Color','Twemoji Mozilla',system-ui,sans-serif;
                              color:{{ section.settings.emoji_color }};
                              font-size:{{ section.settings.emoji_size }}px;
                              line-height:1;
                              display:inline-block;
                            "
                          >
                            {{ raw }}
                          </span>
                        {%- endif -%}
                      {%- endif -%}

                      <span style="font-size:{{ block.settings.font_size }}px; color:{{ block.settings.text_color }}; line-height:1.3; padding-left: 10px;">
                        {{ _question_text }}
                      </span>

                      <span class="caret-icon" aria-hidden="true">
                        <svg class="icon-accordion" viewBox="0 0 20 20" width="20" height="20">
                          <path fill-rule="evenodd" d="M7.5 5.5a.75.75 0 011.06 0l4 4a.75.75 0 010 1.06l-4 4a.75.75 0 11-1.06-1.06L10.44 10 7.5 7.06a.75.75 0 010-1.56z" clip-rule="evenodd" />
                        </svg>
                      </span>
                    </div>
                    <div class="panel-body">
                      <div
                        id="faq-{{ section.id }}-{{ block.id }}"
                        class="collapse"
                        data-parent="#Accordion-{{ section.id }}"
                      >
                        <div class="item-content rte">{{ _answer_text }}</div>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('Accordion-{{ section.id }}');
      if (!root) return;

      // optional "animate" reveal
      {% if section.settings.animate %}
      var animEls = root.querySelectorAll('[data-anim]');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) en.target.classList.add('in');
        });
      }, { threshold: 0.08 });
      animEls.forEach(function (el) { io.observe(el); });
      {% endif %}

      root.querySelectorAll('.collapse').forEach(function (el) {
        el.style.maxHeight = el.classList.contains('show') ? el.scrollHeight + 'px' : '0px';
      });

      function openPanel(panel, header) {
        var main = header.closest('.faqs-main');
        panel.classList.add('show');
        panel.style.maxHeight = panel.scrollHeight + 'px';
        if (main) main.classList.add('active');
      }

      function closePanel(panel, header) {
        var main = header.closest('.faqs-main');
        panel.style.maxHeight = panel.scrollHeight + 'px';
        requestAnimationFrame(function () {
          panel.style.maxHeight = '0px';
          panel.addEventListener('transitionend', function handler() {
            panel.classList.remove('show');
            if (main) main.classList.remove('active');
            panel.removeEventListener('transitionend', handler);
          });
        });
      }

      function closeSiblings(except) {
        root.querySelectorAll('.collapse.show').forEach(function (openEl) {
          if (openEl !== except) {
            var head = root.querySelector('.panel-header[data-target="#' + openEl.id + '"]');
            closePanel(openEl, head);
            if (head) head.setAttribute('aria-expanded', 'false');
          }
        });
      }

      root.addEventListener('click', function (e) {
        var btn = e.target.closest('.panel-header');
        if (!btn) return;

        var targetSel = btn.getAttribute('data-target');
        var panel = root.querySelector(targetSel);
        if (!panel) return;

        var isOpen = panel.classList.contains('show');
        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false');
          closePanel(panel, btn);
        } else {
          closeSiblings(panel);
          btn.setAttribute('aria-expanded', 'true');
          openPanel(panel, btn);
        }
      });

      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') {
          root.querySelectorAll('.collapse').forEach(function (el) {
            el.style.maxHeight = el.classList.contains('show') ? el.scrollHeight + 'px' : '0px';
          });
        }
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "BAH FAQ Accordion",
  "settings": [
    { "type": "text", "id": "is_show", "label": "Show/Hide Info", "default": "true" },

    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>BAH Image Width Text</p>" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#222222" },

    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sub heading",
      "default": "<p>Subtitle from happy customers</p>"
    },
    { "type": "color", "id": "subheading_color", "label": "Sub heading color", "default": "#666666" },
    {
      "type": "color",
      "id": "emoji_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "emoji_size",
      "label": "Icon size",
      "min": 14,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "text-left",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-right", "label": "Right" }
      ]
    },

    { "type": "checkbox", "id": "animate", "label": "Show animated", "default": true },

    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 80,
      "step": 5,
      "label": "Item spacing",
      "unit": "px",
      "default": 30,
      "info": "Spacing between FAQ items"
    },

    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" },
        { "value": "container-full", "label": "Container full width" }
      ]
    },

    {
      "type": "select",
      "id": "width_block",
      "label": "Laptop width",
      "info": "Breakpoint 992px ↑",
      "default": "col-lg-6",
      "options": [
        { "value": "col-lg-1", "label": "1/12" },
        { "value": "col-lg-2", "label": "2/12" },
        { "value": "col-lg-3", "label": "3/12" },
        { "value": "col-lg-4", "label": "4/12" },
        { "value": "col-lg-5", "label": "5/12" },
        { "value": "col-lg-6", "label": "6/12" },
        { "value": "col-lg-7", "label": "7/12" },
        { "value": "col-lg-8", "label": "8/12" },
        { "value": "col-lg-9", "label": "9/12" },
        { "value": "col-lg-10", "label": "10/12" },
        { "value": "col-lg-11", "label": "11/12" },
        { "value": "col-lg-12", "label": "12/12" },
        { "value": "col-lg-cus-5", "label": "1/5" }
      ]
    },

    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "color_background", "id": "gradient", "label": "Background gradient" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },

    { "type": "text", "id": "class", "label": "Extra CSS class" },
    { "type": "number", "id": "px", "label": "Horizontal padding (px)", "default": 0 },

    { "type": "header", "content": "Spacing top (px)" },
