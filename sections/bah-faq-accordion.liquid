{%- comment -%}
  FAQs from entity.metafields.custom.product_faqs_accordion1..5
  Supported shapes:
    1) Metaobject / object with fields: question, answer
    2) JSON metafield resolved to object with question/answer
    3) Plain string "Question || Answer" (fallback)
{%- endcomment -%}

{%- assign sst = section.settings -%}

{%- assign entity = product -%}
{%- if entity == null -%}{% assign entity = page %}{% endif -%}
{%- if entity == null -%}{% assign entity = collection %}{% endif -%}
{%- if entity == null -%}{% assign entity = shop %}{% endif -%}

{%- assign any_faq = false -%}
{%- for i in (1..5) -%}
  {%- assign key = 'product_faqs_accordion' | append: i -%}
  {%- assign mf = entity.metafields.custom[key] -%}
  {%- if mf != blank -%}
    {%- assign any_faq = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if any_faq -%}
  {%- for i in (1..5) -%}
    {%- assign key = 'product_faqs_accordion' | append: i -%}
    {%- assign mf = entity.metafields.custom[key] -%}
    {%- if mf == blank -%}{% continue %}{% endif -%}

    {%- assign val = mf.value -%}
    {%- assign q = blank -%}
    {%- assign a = blank -%}

    {%- comment -%} Detect object/metaobject with fields {%- endcomment -%}
    {%- assign has_q = false -%}
    {%- assign has_a = false -%}
    {%- if val -%}
      {%- if val.question != blank -%}{% assign has_q = true %}{%- endif -%}
      {%- if val.answer != blank -%}{% assign has_a = true %}{%- endif -%}
    {%- endif -%}

    {%- if has_q -%}{% assign q = val.question %}{%- endif -%}
    {%- if has_a -%}{% assign a = val.answer %}{%- endif -%}

    {%- if q == blank and a == blank -%}
      {%- comment -%} Fallback: treat as string "Question || Answer" {%- endcomment -%}
      {%- assign raw = mf.value | default: mf | strip -%}
      {%- if raw contains '||' -%}
        {%- assign parts = raw | split: '||' -%}
        {%- assign q = parts[0] | strip -%}
        {%- assign a = parts[1] | strip -%}
      {%- else -%}
        {%- assign q = raw -%}
      {%- endif -%}
    {%- endif -%}

    {%- if q != blank and a != blank -%}
      <div class="faqs-main {{ sst.width_block }}">
        <div class="panel-group">
          <div
            class="panel-header"
            aria-controls="faq-{{ section.id }}-{{ i }}"
            data-target="#faq-{{ section.id }}-{{ i }}"
          >
            <span style="font-size:16px; color:#000; line-height:1.3; padding-left:10px;">
              {{ q }}
            </span>

            <span class="caret-icon" aria-hidden="true">
              <svg class="icon-accordion" viewBox="0 0 20 20" width="20" height="20">
                <path fill-rule="evenodd" d="M7.5 5.5a.75.75 0 011.06 0l4 4a.75.75 0 010 1.06l-4 4a.75.75 0 11-1.06-1.06L10.44 10 7.5 7.06a.75.75 0 010-1.56z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>

          <div class="panel-body">
            <div
              id="faq-{{ section.id }}-{{ i }}"
              class="collapse"
              data-parent="#Accordion-{{ section.id }}"
            >
              <div class="item-content rte">
                {%- if has_a -%}
                  {{ a }}
                {%- else -%}
                  {{ a }}
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  <script>
    (function () {
      var root = document.getElementById('Accordion-{{ section.id }}');
      if (!root) return;

      // optional "animate" reveal
      {% if section.settings.animate %}
      var animEls = root.querySelectorAll('[data-anim]');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) en.target.classList.add('in');
        });
      }, { threshold: 0.08 });
      animEls.forEach(function (el) { io.observe(el); });
      {% endif %}

      root.querySelectorAll('.collapse').forEach(function (el) {
        el.style.maxHeight = el.classList.contains('show') ? el.scrollHeight + 'px' : '0px';
      });

      function openPanel(panel, header) {
        var main = header.closest('.faqs-main');
        panel.classList.add('show');
        panel.style.maxHeight = panel.scrollHeight + 'px';
        if (main) main.classList.add('active');
      }

      function closePanel(panel, header) {
        var main = header.closest('.faqs-main');
        panel.style.maxHeight = panel.scrollHeight + 'px';
        requestAnimationFrame(function () {
          panel.style.maxHeight = '0px';
          panel.addEventListener('transitionend', function handler() {
            panel.classList.remove('show');
            if (main) main.classList.remove('active');
            panel.removeEventListener('transitionend', handler);
          });
        });
      }

      function closeSiblings(except) {
        root.querySelectorAll('.collapse.show').forEach(function (openEl) {
          if (openEl !== except) {
            var head = root.querySelector('.panel-header[data-target="#' + openEl.id + '"]');
            closePanel(openEl, head);
            if (head) head.setAttribute('aria-expanded', 'false');
          }
        });
      }

      root.addEventListener('click', function (e) {
        var btn = e.target.closest('.panel-header');
        if (!btn) return;

        var targetSel = btn.getAttribute('data-target');
        var panel = root.querySelector(targetSel);
        if (!panel) return;

        var isOpen = panel.classList.contains('show');
        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false');
          closePanel(panel, btn);
        } else {
          closeSiblings(panel);
          btn.setAttribute('aria-expanded', 'true');
          openPanel(panel, btn);
        }
      });

      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') {
          root.querySelectorAll('.collapse').forEach(function (el) {
            el.style.maxHeight = el.classList.contains('show') ? el.scrollHeight + 'px' : '0px';
          });
        }
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "BAH FAQ Accordion",
  "settings": [
    { "type": "text", "id": "is_show", "label": "Show/Hide Info", "default": "true" },

    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>BAH Image Width Text</p>" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#222222" },

    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sub heading",
      "default": "<p>Subtitle from happy customers</p>"
    },
    { "type": "color", "id": "subheading_color", "label": "Sub heading color", "default": "#666666" },
    {
      "type": "color",
      "id": "emoji_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "emoji_size",
      "label": "Icon size",
      "min": 14,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "text-left",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-right", "label": "Right" }
      ]
    },

    { "type": "checkbox", "id": "animate", "label": "Show animated", "default": true },

    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 80,
      "step": 5,
      "label": "Item spacing",
      "unit": "px",
      "default": 30,
      "info": "Spacing between FAQ items"
    },

    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Container" },
        { "value": "container-fluid", "label": "Container fluid" },
        { "value": "container-full", "label": "Container full width" }
      ]
    },

    {
      "type": "select",
      "id": "width_block",
      "label": "Laptop width",
      "info": "Breakpoint 992px ↑",
      "default": "col-lg-6",
      "options": [
        { "value": "col-lg-1", "label": "1/12" },
        { "value": "col-lg-2", "label": "2/12" },
        { "value": "col-lg-3", "label": "3/12" },
        { "value": "col-lg-4", "label": "4/12" },
        { "value": "col-lg-5", "label": "5/12" },
        { "value": "col-lg-6", "label": "6/12" },
        { "value": "col-lg-7", "label": "7/12" },
        { "value": "col-lg-8", "label": "8/12" },
        { "value": "col-lg-9", "label": "9/12" },
        { "value": "col-lg-10", "label": "10/12" },
        { "value": "col-lg-11", "label": "11/12" },
        { "value": "col-lg-12", "label": "12/12" },
        { "value": "col-lg-cus-5", "label": "1/5" }
      ]
    },

    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "color_background", "id": "gradient", "label": "Background gradient" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },

    { "type": "text", "id": "class", "label": "Extra CSS class" },
    { "type": "number", "id": "px", "label": "Horizontal padding (px)", "default": 0 },

    { "type": "header", "content": "Spacing top (px)" },
    { "type": "number", "id": "distance_top_xl", "label": "Large laptop ≥1200px", "default": 30 },
    { "type": "number", "id": "distance_top_md", "label": "Tablet ≥768px", "default": 30 },
    { "type": "number", "id": "distance_top_xs", "label": "Mobile", "default": 30 },

    { "type": "header", "content": "Spacing bottom (px)" },
    { "type": "number", "id": "distance_bottom_xl", "label": "Large laptop ≥1200px", "default": 30 },
    { "type": "number", "id": "distance_bottom_lg", "label": "Laptop ≥992px", "default": 30 },
    { "type": "number", "id": "distance_bottom_md", "label": "Tablet ≥768px", "default": 30 },
    { "type": "number", "id": "distance_bottom_xs", "label": "Mobile", "default": 30 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Sample question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Sample answer text here.</p>" },
        { "type": "color", "id": "text_color", "label": "Question color", "default": "#000000" },
        {
          "type": "range",
          "id": "font_size",
          "label": "Question font size",
          "min": 12,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        { "type": "text", "id": "icon", "label": "Icon" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "presets": [{ "name": "BAH FAQ Accordion", "category": "Text" }]
}
{% endschema %}
