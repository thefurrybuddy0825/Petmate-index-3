{% comment %}
  BAH — Collapsible Content (FAQ) — Typed Fields + Rich Text + Icons

  Product metafield (preferred, optional):
    product.metafields.custom.product_collapsible_content → Metaobject reference

  Metaobject typed fields (create these):
    - is_show : Boolean
    - faq_title_1..faq_title_5   : Text
    - faq_content_1..faq_content_5 : Rich text (or multi-line text)
    - faq_icon_1..faq_icon_5     : Text (emoji like ✔ / 🐾 or hex like 2714)

  Block settings (fallbacks; create matching ids):
    - is_show (checkbox)
    - faq_title_1..faq_title_5 (text)
    - faq_content_1..faq_content_5 (richtext preferred)
    - faq_icon_1..faq_icon_5 (text)
    - font_size (number), text_color (color)
    - emoji_size (number, px) ← icon size
    - emoji_color (color)     ← icon color
    - margin_top, margin_bottom (numbers)
{% endcomment %}

{% style %}
  .accordion { margin-left: 0 !important; margin-right: 0 !important; }

  /* Row divider */
  .faq-accordion .faqs-main { position: relative; border-bottom: 1px solid rgba(var(--color-foreground), 0.16); }
  .faq-accordion .faqs-main:last-child { border-bottom: none; }

  /* Underline bar on active */
  .faq-accordion .faqs-main::before {
    content: '';
    position: absolute;
    top: -1px; left: 0;
    height: 3px; width: 200px;
    background: #222222;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s ease;
    z-index: 1;
  }
  .faq-accordion .faqs-main.active::before { transform: scaleX(1); }

  /* Header row */
  .faq-accordion .panel-header {
    display: flex; align-items: center; width: 100%; text-align: left;
    background: transparent; border: 0; padding: 1.4rem 0; margin: 0;
    font-weight: 600; font-size: 16px; cursor: pointer; transition: color 0.25s ease;
    border-top: 1px solid var(--color-border);
  }

  /* Caret rotation */
  .faq-accordion .panel-header .caret-icon { margin-left: auto; transition: transform var(--duration-short, 150ms) ease; }
  .faq-accordion .panel-header[aria-expanded="true"] .caret-icon { transform: rotate(90deg); }

  /* Animated collapse */
  .faq-accordion .collapse { overflow: hidden; max-height: 0; opacity: 0; transition: max-height 300ms ease, opacity 240ms ease; }
  .faq-accordion .collapse.show { opacity: 1; /* max-height set inline by JS */ }

  .faq-accordion .item-content { padding: 0 0 1.4rem 0; font-size: 16px !important; border: none !important; }
{% endstyle %}

{% for block in section.blocks %}
  {% if block.type == 'bah-collapsible-content' %}
    <div
      class="accordion faq-accordion"
      id="Accordion-{{ section.id | append: forloop.index }}"
      style="margin-top: {{ block.settings.margin_top | default: 0 }}px; margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;"
    >
      {%- assign mf = product.metafields.custom.product_collapsible_content -%}
      {%- assign mo = null -%}
      {%- if mf != blank and mf.type contains 'metaobject' -%}
        {%- assign mo = mf.value -%}
      {%- endif -%}

      {%- comment -%} Show/hide: product first, then block fallback {%- endcomment -%}
      {%- assign is_show = null -%}
      {%- if mo and mo.is_show != null -%}{%- assign is_show = mo.is_show -%}{%- endif -%}
      {%- if is_show == null -%}{%- assign is_show = block.settings.is_show | default: true -%}{%- endif -%}

      {%- if is_show == true -%}
        {%- assign text_sz = block.settings.font_size | default: 16 -%}
        {%- assign text_col = block.settings.text_color | default: '#000' -%}
        {%- assign icon_px = block.settings.emoji_size | default: text_sz -%}
        {%- assign icon_col = block.settings.emoji_color | default: text_col -%}

        {%- comment -%} Build rows (titles, rich text contents, icons) {%- endcomment -%}
        {%- capture rows -%}
          {%- for i in (1..5) -%}
            {%- assign t_key = 'faq_title_'   | append: i -%}
            {%- assign c_key = 'faq_content_' | append: i -%}
            {%- assign ic_key = 'icon_'   | append: i -%}

            {%- assign t = '' -%}
            {%- assign c_html = '' -%}
            {%- assign ic = '' -%}

            {%- if mo -%}
              {%- case i -%}
                {%- when 1 -%}{%- assign t = mo.faq_title_1   -%}{%- assign c_obj = mo.faq_content_1   -%}{%- assign ic = mo.faq_icon_1   -%}
                {%- when 2 -%}{%- assign t = mo.faq_title_2   -%}{%- assign c_obj = mo.faq_content_2   -%}{%- assign ic = mo.faq_icon_2   -%}
                {%- when 3 -%}{%- assign t = mo.faq_title_3   -%}{%- assign c_obj = mo.faq_content_3   -%}{%- assign ic = mo.faq_icon_3   -%}
                {%- when 4 -%}{%- assign t = mo.faq_title_4   -%}{%- assign c_obj = mo.faq_content_4   -%}{%- assign ic = mo.faq_icon_4   -%}
                {%- when 5 -%}{%- assign t = mo.faq_title_5   -%}{%- assign c_obj = mo.faq_content_5   -%}{%- assign ic = mo.faq_icon_5   -%}
              {%- endcase -%}

              {%- if c_obj != blank -%}
                {%- comment -%} Prefer metafield_tag for rich text metaobject fields {%- endcomment -%}
                {%- assign c_html = c_obj | metafield_tag -%}
                {%- if c_html == blank and c_obj.value != blank -%}
                  {%- assign c_html = c_obj.value -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}

            {%- if t == blank -%}{%- assign t = block.settings[t_key]  | default: '' -%}{%- endif -%}
            {%- if c_html == blank -%}{%- assign c_html = block.settings[c_key] | default: '' -%}{%- endif -%}
            {%- if ic == blank -%}{%- assign ic = block.settings[ic_key] | default: '' -%}{%- endif -%}

            {%- assign has_any = false -%}
            {%- if t != blank or c_html != blank -%}{%- assign has_any = true -%}{%- endif -%}

            {%- if has_any -%}
              {%- comment -%} Prepare icon HTML if provided (emoji or hex) {%- endcomment -%}
              {%- assign ic_trim = ic | strip -%}
              {%- assign icon_html = '' -%}
              {%- if ic_trim != '' -%}
                {%- assign norm = ic_trim
                  | downcase
                  | remove: 'u+' | remove: '0x' | remove: '&#x' | remove: '&#' | remove: ';'
                  | strip
                -%}
                {%- assign HEX = norm | upcase -%}
                {%- assign clean = HEX
                  | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4'
                  | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
                  | remove: 'A' | remove: 'B' | remove: 'C' | remove: 'D' | remove: 'E' | remove: 'F'
                -%}
                {%- assign is_hex = false -%}
                {%- if HEX != '' and clean == '' -%}{%- assign is_hex = true -%}{%- endif -%}

                {%- capture icon_html -%}
                  <span aria-hidden="true" class="faq-title-icon" style="font-size:{{ icon_px }}px; color:{{ icon_col }}; line-height:1; display:inline-block; margin-right:8px;">
                    {%- if is_hex -%}{{ '&#x' | append: HEX | append: ';' }}{%- else -%}{{ ic_trim }}{%- endif -%}
                  </span>
                {%- endcapture -%}
              {%- endif -%}

              {%- assign uid = section.id | append: '-u-' | append: block.id | append: '-' | append: i -%}
              <div class="faqs-main" style="font-size: {{ text_sz }}px;">
                <div class="panel-group">
                  <button class="panel-header" type="button" aria-controls="faq-{{ uid }}" aria-expanded="false" data-target="#faq-{{ uid }}">
                    {{ icon_html }}
                    <span style="font-size:{{ text_sz }}px; color:{{ text_col }}; line-height:1.3;">
                      {{- t | default: 'Details' -}}
                    </span>
                    <span class="caret-icon" aria-hidden="true">
                      <svg class="icon-accordion" viewBox="0 0 20 20" width="20" height="20" role="presentation" focusable="false" aria-hidden="true">
                        <path fill-rule="evenodd"
                          d="M7.5 5.5a.75.75 0 011.06 0l4 4a.75.75 0 010 1.06l-4 4a.75.75 0 11-1.06-1.06L10.44 10 7.5 7.06a.75.75 0 010-1.56z"
                          clip-rule="evenodd" />
                      </svg>
                    </span>
                  </button>

                  <div class="panel-body">
                    <div id="faq-{{ uid }}" class="collapse" data-parent="#Accordion-{{ section.id }}">
                      <div class="item-content rte" style="padding: 0 0 20px 0; color: {{ text_col }};">
                        {{ c_html }}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- assign rows_trim = rows | strip -%}
        {%- if rows_trim != '' -%}
          {{ rows }}
        {%- endif -%}
      {%- endif -%}
    </div>

    <script>
      (function () {
        var root = document.getElementById('Accordion-{{ section.id | append: forloop.index }}');
        if (!root) return;

        // Initialize max-heights for smooth animation
        root.querySelectorAll('.collapse').forEach(function (el) {
          el.style.maxHeight = el.classList.contains('show') ? el.scrollHeight + 'px' : '0px';
        });

        function openPanel(panel, header) {
          var main = header.closest('.faqs-main');
          panel.classList.add('show');
          panel.style.maxHeight = panel.scrollHeight + 'px';
          if (main) main.classList.add('active');
        }

        function closePanel(panel, header) {
          var main = header.closest('.faqs-main');
          panel.style.maxHeight = panel.scrollHeight + 'px';
          requestAnimationFrame(function () {
            panel.style.maxHeight = '0px';
            panel.addEventListener('transitionend', function handler() {
              panel.classList.remove('show');
              if (main) main.classList.remove('active');
              panel.removeEventListener('transitionend', handler);
            });
          });
        }

        function closeSiblings(except) {
          root.querySelectorAll('.collapse.show').forEach(function (openEl) {
            if (openEl !== except) {
              var head = root.querySelector('.panel-header[data-target="#' + openEl.id + '"]');
              closePanel(openEl, head);
              if (head) head.setAttribute('aria-expanded', 'false');
            }
          });
        }

        root.addEventListener('click', function (e) {
          var btn = e.target.closest('.panel-header');
          if (!btn) return;

          var targetSel = btn.getAttribute('data-target');
          var panel = root.querySelector(targetSel);
          if (!panel) return;

          var isOpen = panel.classList.contains('show');
          if (isOpen) {
            btn.setAttribute('aria-expanded', 'false');
            closePanel(panel, btn);
          } else {
            closeSiblings(panel);
            btn.setAttribute('aria-expanded', 'true');
            openPanel(panel, btn);
          }
        });

        document.addEventListener('shopify:section:load', function (e) {
          if (e.detail && e.detail.sectionId === '{{ section.id }}') {
            var newRoot = document.getElementById('Accordion-{{ section.id | append: forloop.index }}');
            if (!newRoot) return;
            newRoot.querySelectorAll('.collapse').forEach(function (el) {
              el.style.maxHeight = el.classList.contains('show') ? el.scrollHeight + 'px' : '0px';
            });
          }
        });
      })();
    </script>
  {% endif %}
{% endfor %}
