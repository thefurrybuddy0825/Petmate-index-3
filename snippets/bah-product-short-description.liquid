{%- comment -%}
  COMPONENT: Product Short Description (block: `bah-product-short-des`)
  PURPOSE:
    Renders a short blurb under the product title. Reads from a PRODUCT METAFIELD
    (metaobject reference) with block settings as fallback.

  NEW (typed-first):
    • Metaobject fields (preferred): is_show:Boolean, description:Multi-line text
    • Legacy fallback during migration: mo.settings JSON string
      - We DO NOT parse JSON in Liquid (no parse_json). We only probe is_show and
        do a simple substring extraction for description.

  REQUIRED SETUP:
    • Metaobject type: product_short_description
      - Fields: is_show:Boolean, description:Multi-line text
      - (Optional legacy) settings: Single line text (JSON string)
    • Product metafield (Products scope):
      - Namespace/key: custom.product_short_description
      - Type: Metaobject reference → product_short_description
    • Make sure metaobject type + metafield are published to Storefront.

  BLOCK SETTINGS (fallbacks + style):
    - is_show (checkbox)
    - description (text/textarea)
    - font_size (px), padding_* (px)

{%- endcomment -%}

{% for block in section.blocks %}
  {% case block.type %}
    {% when 'bah-product-short-des' %}
      {%- assign mf = product.metafields.custom.product_short_description -%}
      {%- assign short_description_mo = nil -%}
      {%- if mf != blank and mf.type contains 'metaobject' -%}
        {%- assign short_description_mo = mf.value -%}
      {%- endif -%}

      {%- comment -%} Normalize into variables (typed fields first) {%- endcomment -%}
      {%- assign is_show = nil -%}
      {%- assign short_description = '' -%}

      {%- if short_description_mo -%}
        {%- comment -%} Preferred: typed metaobject fields {%- endcomment -%}
        {%- if short_description_mo.is_show != nil -%}
          {%- assign is_show = short_description_mo.is_show -%}
        {%- endif -%}
        {%- if short_description_mo.description != blank -%}
          {%- assign short_description = short_description_mo.description -%}
        {%- endif -%}
      {%- endif -%}
{{ is_show }}
      {%- comment -%} Fallbacks to block settings {%- endcomment -%}
      {%- if is_show == nil -%}
        {%- assign is_show = block.settings.is_show | default: true -%}
      {%- endif -%}
      {%- if short_description == '' -%}
        {%- assign short_description = block.settings.description | default: '' -%}
      {%- endif -%}

      {%- comment -%} Normalize boolean variants {%- endcomment -%}
      {%- if is_show == true -%}
        {%- assign should_render = true -%}
      {%- else -%}
        {%- assign should_render = false -%}
      {%- endif -%}

      {%- if should_render and short_description != '' -%}
        <div
          class="short-description"
          style="
            font-size: {{ block.settings.font_size | default: 16 }}px;
            padding: {{ block.settings.padding_top   | default: 10 }}px
                     {{ block.settings.padding_right | default: 0 }}px
                     {{ block.settings.padding_bottom| default: 10 }}px
                     {{ block.settings.padding_left  | default: 0 }}px;
          "
        >
          <span>{{ short_description | newline_to_br }}</span>
        </div>
      {%- endif -%}
  {% endcase %}
{% endfor %}
