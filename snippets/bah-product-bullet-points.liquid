{%- comment -%}
  BAH – Product Bullet Points (dynamic keys, hard-coded icon)
  Metaobject (product.metafields.custom.product_bullet_points → value):
    - is_show:Boolean
    - bullet_point_1 … bullet_point_5 : Multi-line text
  Block settings fallbacks:
    - is_show (checkbox)
    - bullet_point_1 … bullet_point_5 (textarea)
    - body_font_size, text_color, row_gap
{%- endcomment -%}

{% for block in section.blocks %}
  {% if block.type == 'bah-product-bullet-points' %}
    {%- assign mf = product.metafields.custom.product_bullet_points -%}
    {%- assign mo = nil -%}
    {%- if mf != blank and mf.type contains 'metaobject' -%}
      {%- assign mo = mf.value -%}
    {%- endif -%}

    {%- assign is_show = nil -%}
    {%- if mo and mo.is_show != nil -%}{%- assign is_show = mo.is_show -%}{%- endif -%}
    {%- if is_show == nil -%}{%- assign is_show = block.settings.is_show -%}{%- endif -%}

    {%- assign text_sz  = block.settings.body_font_size | default: 14 -%}
    {%- assign text_col = block.settings.text_color    | default: '#000' -%}
    {%- assign row_gap  = block.settings.row_gap       | default: 8 -%}
    {%- assign ICON_CHAR = '🐾' -%}
    {%- assign ICON_SIZE = text_sz -%}

    {%- assign base = 'bullet_point_' -%}
    {%- capture bullets -%}
      {%- for i in (1..5) -%}
        {%- assign key = base | append: i -%}
        {%- assign txt = '' -%}

        {%- if mo and mo[key] != blank -%}
          {%- assign txt = mo[key] -%}
        {%- endif -%}
        {%- if txt == '' -%}
          {%- assign txt = block.settings[key] -%}
        {%- endif -%}

        {%- if txt != blank -%}
          <li style="display:flex;align-items:flex-start;gap:8px;margin:0 0 {{ row_gap }}px 0;">
            <span aria-hidden="true" style="font-size:{{ ICON_SIZE }}px;line-height:1;display:inline-block;">{{ ICON_CHAR }}</span>
            <span style="font-size:{{ text_sz }}px;color:{{ text_col }};line-height:1.3;">{{ txt | newline_to_br }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if is_show == true and bullets != blank -%}
      <ul class="bah-product-bullet-points" style="margin:10px 0; padding:0; list-style:none;">
        {{ bullets }}
      </ul>
    {%- endif -%}
  {% endif %}
{% endfor %}
