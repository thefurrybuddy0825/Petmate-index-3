{%- comment -%}
  BAH – Product Bullet Points (typed fields + loop)
  - Product metafield: custom.product_bullet_points (Metaobject reference)
    Metaobject fields: is_show:Boolean, bullet_1..bullet_5: Multi-line text
  - Block settings (fallbacks): is_show (checkbox), bullet_1..bullet_5 (textarea),
    body_font_size, text_color, row_gap
{%- endcomment -%}

{% for block in section.blocks %}
  {% if block.type == 'bah-product-bullet-points' %}
    {%- assign mf = product.metafields.custom.product_bullet_points -%}
    {%- assign mo = nil -%}
    {%- if mf != blank and mf.type contains 'metaobject' -%}
      {%- assign mo = mf.value -%}
    {%- endif -%}

    {%- comment -%} is_show: product first, else block {%- endcomment -%}
    {%- assign is_show = nil -%}
    {%- if mo and mo.is_show != nil -%}
      {%- assign is_show = mo.is_show -%}
    {%- endif -%}
    {%- if is_show == nil -%}
      {%- assign is_show = block.settings.is_show -%}
    {%- endif -%}

    {%- comment -%} Style settings {%- endcomment -%}
    {%- assign text_sz  = block.settings.body_font_size | default: 14 -%}
    {%- assign text_col = block.settings.text_color    | default: '#000' -%}
    {%- assign row_gap  = block.settings.row_gap       | default: 8 -%}

    {%- comment -%}
      Build <li> items via a loop. For each i in 1..5:
      - Try mo.bullet_i (via mo.fields scan)
      - Fallback to block.settings['bullet_i']
    {%- endcomment -%}
    {%- capture bullet_items -%}
      {%- for i in (1..5) -%}
        {%- assign key = 'bullet_point_' | append: i -%}
        {%- assign txt = '' -%}
            {{ mo.fields }}
        {%- if mo -%}
          {%- comment -%} Find field in mo.fields with matching key {%- endcomment -%}
          {%- for f in mo.fields -%}

            {%- if f.key == key and f.value != blank -%}
              {%- assign txt = f.value -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if txt == '' -%}
          {%- assign txt = block.settings[key] -%}
        {%- endif -%}

        {%- if txt != blank -%}
          <li style="display:flex;align-items:flex-start;gap:8px;margin:0 0 {{ row_gap }}px 0;">
            <span style="font-size:{{ text_sz }}px;color:{{ text_col }};line-height:1.3;">{{ txt | newline_to_br }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if is_show == true and bullet_items != blank -%}
      <ul class="bah-product-bullet-points" style="margin:10px 0; padding:0; list-style:none;">
        {{ bullet_items }}
      </ul>
    {%- endif -%}
  {% endif %}
{% endfor %}
