{% comment %}
  BAH – Product Bullet Points (Usage)

  Where to put data
  -----------------
  Option A) Product JSON metafield
  - Namespace: custom
  - Key: product_bullet_points
  - Type: JSON
  - Value must match the "Sample JSON" below.

  Option B) Metaobject field
  - Make a metaobject that has a JSON field named "json_shema".
  - Set product.metafields.custom.product_bullet_points to a reference to that metaobject.
  - This snippet will read metaobject.value.json_shema (fallbacks: metaobject.json_shema, metaobject.value, the metafield itself).

  Data format (what the snippet expects)
  --------------------------------------
  {
    "is_show": true,                // If false, nothing renders.
    "items": [
      {
        "text": "Line text",        // Required
        "icon": "🐾 or e873",       // Optional; wins over image if provided
        "image": "filename.png"     // Optional; used if no icon
      }
    ]
  }

  Icons
  -----
  - Emoji works as-is: "🐾", "⭐", "✅", etc.
  - Hex codepoints (for icon fonts) are allowed: "e873", "#e873", "0xE873".
    The snippet auto-normalizes these and renders with Material Icons / Symbols.

  Images
  ------
  - For best results, upload to Settings → Files and store ONLY the filename ("return-box.png").
    (No "files/" prefix needed.)
  - Full URLs also work.

  Block settings this snippet uses
  --------------------------------
  - body_font_size (text size, px)
  - text_color (text color)
  - emoji_color (icon color when using hex icon)
  - emoji_size (icon/image square size, px)

  Priority
  --------
  - If item.icon is present (non-blank), it is rendered.
  - Otherwise, if item.image is present, the image is rendered.
  - If both are present, icon wins.

  Troubleshooting
  ---------------
  - If images don't show: ensure the filename exists in Settings → Files (spelling matters).
  - If hex icon doesn’t show: verify the codepoint is valid for your icon font (e.g., "e873").

  Sample JSON (put this into your metafield value)
  ---------------
  {
  "is_show": true,
  "items": [
    { "text": "Sample with Image", "image": "sample.png" },
    { "text": "Sample with Icon", "icon": "⭐" },
    { "text": "Sample with HEX Icon", "icon": "e873" }
  ]
  }
{% endcomment %}

<ul class="bah-product-bullet-points" style="margin:10px 0; padding:0; list-style:none;">
  {% for block in section.blocks %}
    {% if block.type == 'bah-product-bullet-points' %}
      {%- assign mo = null -%}
      {%- assign mf = product.metafields.custom.product_bullet_points -%}
      {%- if mf != blank -%}
        {%- if mf.type contains 'metaobject' -%}
          {%- assign mo = mf.value -%}
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} Normalize into variables {%- endcomment -%}
      {%- assign is_show = true -%}
      {%- assign items = '' | split: ',' -%}

      {%- if mo -%}
        {%- assign cfg = mf.value.json_schema | default: mf.json_schema | default: mf.value | default: mf -%}

        {%- assign is_show = cfg.value.is_show -%}
        {%- if is_show == null -%}
          {%- assign is_show = block.settings.is_show -%}
        {%- endif -%}
        {%- if is_show != true and is_show != false and is_show != null -%}
          {%- assign v = is_show | downcase | strip -%}
          {%- if v == 'true' or v == '1' or v == 'yes' or v == 'y' -%}
            {%- assign is_show = true -%}
          {%- else -%}
            {%- assign is_show = false -%}
          {%- endif -%}
        {%- endif -%}

        {%- assign items = cfg.value.items -%}
        {%- if items == null or items == '' -%}
          {%- assign items = '' | split: ',' -%}
        {%- endif -%}
      {%- endif -%}

      {% if is_show %}
        {% assign bst = block.settings %}
        {%- assign text_sz = bst.body_font_size | default: 14 -%}
        {%- assign text_col = bst.text_color | default: '#000' -%}
        {%- assign icon_col = bst.emoji_color | default: '#000' -%}
        {%- assign icon_px = bst.emoji_size | default: 18 -%}
        {% assign retina_w = icon_px | times: 2 %}

        {% for item in items %}
          {%- assign text = item.text | default: '' -%}
          {%- assign icon = item.icon | default: '' -%}
          {%- assign image = item.image | default: '' -%}
          {%- assign icon_trim = icon | strip -%}

          {%- comment -%} Build file image URLs (used only if no icon) {%- endcomment -%}
          {% assign img_src = '' %}
          {% assign img_src_1x = '' %}
          {% assign img_src_2x = '' %}
          {% if image != '' %}
            {% if image contains '://' %}
              {% assign img_src = image %}
              {% assign img_src_1x = image %}
              {% assign img_src_2x = image %}
            {% else %}
              {% assign size1x = icon_px | append: 'x' %}
              {% assign size2x = retina_w | append: 'x' %}
              {% assign img_src_1x = image | file_img_url: size1x %}
              {% assign img_src_2x = image | file_img_url: size2x %}
              {% assign img_src = img_src_2x %}
            {% endif %}
          {% endif %}

          {%- comment -%} Prepare hex/emoji detection (only if we actually have an icon) {%- endcomment -%}
          {% assign is_hex = false %}
          {% assign HEX = '' %}
          {% if icon_trim != blank %}
            {% assign normalized_code = icon_trim
              | replace: '0x', ''
              | replace: '#', ''
              | replace: ',', ' '
              | replace: ';', ' '
              | replace: '/', ' '
              | replace: '|', ' '
              | replace: '+', ' '
              | replace: '-', ' '
            %}
            {% assign parts = normalized_code | split: ' ' %}
            {% for p in parts %}
              {% assign tok = p | strip %}
              {% if tok != '' and tok != 'and' %}
                {% assign HEX = tok | upcase %}
                {% break %}
              {% endif %}
            {% endfor %}
            {% assign _clean = HEX
              | remove: '0'
              | remove: '1'
              | remove: '2'
              | remove: '3'
              | remove: '4'
              | remove: '5'
              | remove: '6'
              | remove: '7'
              | remove: '8'
              | remove: '9'
              | remove: 'A'
              | remove: 'B'
              | remove: 'C'
              | remove: 'D'
              | remove: 'E'
              | remove: 'F'
            %}
            {% if HEX != '' and _clean == '' %}
              {% assign is_hex = true %}
            {% endif %}
          {% endif %}

          <li style="display:flex; align-items:center; gap:6px; margin:0 0 10px 0;">
            {% if icon_trim != blank %}
              {% if is_hex %}
                <span
                  aria-hidden="true"
                  style="font-family:'Material Icons','Material Symbols Outlined',sans-serif; color:{{ icon_col }}; font-size:{{ icon_px }}px; line-height:1; display:inline-block;"
                >
                  {{ '&#x' | append: HEX | append: ';' }}
                </span>
              {% else %}
                <span
                  aria-hidden="true"
                  style="font-family:'Apple Color Emoji','Segoe UI Emoji','Noto Color Emoji','Noto Emoji','EmojiOne Color','Twemoji Mozilla',system-ui,sans-serif; font-size:{{ icon_px }}px; line-height:1; display:inline-block;"
                >
                  {{ icon_trim }}
                </span>
              {% endif %}
            {% elsif img_src != '' %}
              <img
                src="{{ img_src | escape }}"
                srcset="{{ img_src_1x | escape }} 1x, {{ img_src_2x | escape }} 2x"
                alt="{{ text | escape }}"
                width="{{ icon_px }}"
                height="{{ icon_px }}"
                loading="lazy"
                style="display:inline-block; width:{{ icon_px }}px; height:{{ icon_px }}px; object-fit:contain; border:0;"
              >
            {% endif %}

            <span style="font-size:{{ text_sz }}px; color:{{ text_col }}; line-height:1.3;">{{ text }}</span>
          </li>
        {% endfor %}
      {% endif %}
    {% endif %}
  {% endfor %}
</ul>
