{% comment %}
  BAH — Collapsible Content (FAQ)
  Order: 1) Product metaobject items (custom fields) → 2) Theme Editor items (t1..t10)

  Product metafield (optional, preferred):
    product.metafields.custom.product_collapsible_content → Metaobject reference

  Metaobject typed fields (create on your metaobject):
    - is_show : Boolean
    - faq_title_1..faq_title_5     : Text
    - faq_content_1..faq_content_5 : Rich text (or multi-line)
    - faq_icon_1..faq_icon_5       : Text (emoji '✔' / '✅' or hex '2714')

  Block settings (fallbacks / Theme Editor items):
    - is_show (you currently use a TEXT field; we parse "true"/"false")
    - Styling: emoji_color, emoji_size, text_color, font_size, margin_top, margin_bottom
    - Theme items (appended AFTER custom fields): t1..t10 (title - text), c1..c10 (content - richtext),
      icon1..icon10 (text), image1..image10 (image_picker)
{% endcomment %}

{% style %}
  .accordion { margin-left: 0 !important; margin-right: 0 !important; }

  .faq-accordion .faqs-main { position: relative; border-bottom: 1px solid rgba(var(--color-foreground), 0.16); }
  .faq-accordion .faqs-main:last-child { border-bottom: none; }

  .faq-accordion .faqs-main::before {
    content: '';
    position: absolute; top: -1px; left: 0; height: 3px; width: 200px;
    background: #222222; transform: scaleX(0); transform-origin: left;
    transition: transform 1s ease; z-index: 1;
  }
  .faq-accordion .faqs-main.active::before { transform: scaleX(1); }

  .faq-accordion .panel-header {
    display:flex; align-items:center; width:100%; text-align:left; background:transparent; border:0;
    padding:1.4rem 0; margin:0; font-weight:600; font-size:16px; cursor:pointer; transition: color .25s ease;
    border-top: 1px solid var(--color-border);
  }

  .faq-accordion .panel-header .caret-icon { margin-left:auto; transition: transform var(--duration-short,150ms) ease; }
  .faq-accordion .panel-header[aria-expanded="true"] .caret-icon { transform: rotate(90deg); }

  .faq-accordion .collapse { overflow:hidden; max-height:0; opacity:0; transition:max-height 300ms ease, opacity 240ms ease; }
  .faq-accordion .collapse.show { opacity:1; }

  .faq-accordion .item-content { padding: 0 0 1.4rem 0; font-size: 16px !important; border: none !important; }
{% endstyle %}

{% for block in section.blocks %}
  {% if block.type == 'bah-collapsible-content' %}
    <div
      class="accordion faq-accordion"
      id="Accordion-{{ section.id | append: forloop.index }}"
      style="margin-top: {{ block.settings.margin_top | default: 0 }}px; margin-bottom: {{ block.settings.margin_bottom | default: 0 }}px;"
    >
      {%- assign mf = product.metafields.custom.product_collapsible_content -%}
      {%- assign mo = nil -%}
      {%- if mf != blank and mf.type contains 'metaobject' -%}
        {%- assign mo = mf.value -%}
      {%- endif -%}

      {%- comment -%} Resolve is_show: product first → parse block.settings.is_show (text) {%- endcomment -%}
      {%- assign is_show = nil -%}
      {%- if mo and mo.is_show != nil -%}{%- assign is_show = mo.is_show -%}{%- endif -%}
      {%- if is_show == nil -%}
        {%- assign bs = block.settings.is_show | downcase | strip -%}
        {%- if bs == 'true' or bs == '1' or bs == 'yes' or bs == 'y' -%}
          {%- assign is_show = true -%}
        {%- else -%}
          {%- assign is_show = false -%}
        {%- endif -%}
      {%- endif -%}

      {%- if is_show == true -%}
        {%- assign text_sz  = block.settings.font_size   | default: 16 -%}
        {%- assign text_col = block.settings.text_color  | default: '#000' -%}
        {%- assign icon_px  = block.settings.emoji_size  | default: text_sz -%}
        {%- assign icon_col = block.settings.emoji_color | default: text_col -%}

        {%- capture all_rows -%}

          {#-----------------------------#}
          {# 1) CUSTOM FIELDS (METAOBJECT) #}
          {#-----------------------------#}
          {%- for i in (1..5) -%}
            {%- assign t = '' -%}
            {%- assign ic = '' -%}
            {%- assign c_html = '' -%}
            {%- if mo -%}
              {%- case i -%}
                {%- when 1 -%}{%- assign t = mo.faq_title_1  -%}{%- assign c_obj = mo.faq_content_1  -%}{%- assign ic = mo.icon_1  -%}
                {%- when 2 -%}{%- assign t = mo.faq_title_2  -%}{%- assign c_obj = mo.faq_content_2  -%}{%- assign ic = mo.icon_2  -%}
                {%- when 3 -%}{%- assign t = mo.faq_title_3  -%}{%- assign c_obj = mo.faq_content_3  -%}{%- assign ic = mo.icon_3  -%}
                {%- when 4 -%}{%- assign t = mo.faq_title_4  -%}{%- assign c_obj = mo.faq_content_4  -%}{%- assign ic = mo.icon_4  -%}
                {%- when 5 -%}{%- assign t = mo.faq_title_5  -%}{%- assign c_obj = mo.faq_content_5  -%}{%- assign ic = mo.icon_5  -%}
              {%- endcase -%}

              {%- if c_obj != blank -%}
                {%- assign c_html = c_obj | metafield_tag -%}
                {%- if c_html == blank and c_obj.value != blank -%}
                  {%- assign c_html = c_obj.value -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}

            {%- assign has_any = false -%}
            {%- if t != blank or c_html != blank -%}{%- assign has_any = true -%}{%- endif -%}

            {%- if has_any -%}
              {%- assign ic_trim = ic | to_s | strip -%}
              {%- assign icon_html = '' -%}
              {%- if ic_trim != '' -%}
                {%- assign norm = ic_trim | downcase | remove: 'u+' | remove: '0x' | remove: '&#x' | remove: '&#' | remove: ';' | strip -%}
                {%- assign HEX = norm | upcase -%}
                {%- assign hex_test = HEX
                  | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4'
                  | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
                  | remove: 'A' | remove: 'B' | remove: 'C' | remove: 'D' | remove: 'E' | remove: 'F'
                -%}
                {%- assign looks_hex = false -%}
                {%- if HEX != '' and hex_test == '' -%}{%- assign looks_hex = true -%}{%- endif -%}

                {%- capture icon_html -%}
                  <span class="faq-title-icon" aria-hidden="true"
                        style="font-size:{{ icon_px }}px; color:{{ icon_col }}; line-height:1; display:inline-block; margin-right:8px;">
                    {%- if looks_hex -%}{{ '&#x' | append: HEX | append: ';' }}{%- else -%}{{ ic_trim }}{%- endif -%}
                  </span>
                {%- endcapture -%}
              {%- endif -%}

              {%- assign uid = section.id | append: '-u-' | append: block.id | append: '-mo-' | append: i -%}
              <div class="faqs-main" style="font-size: {{ text_sz }}px;">
                <div class="panel-group">
                  <button class="panel-header" type="button" aria-controls="faq-{{ uid }}" aria-expanded="false" data-target="#faq-{{ uid }}">
                    {{ icon_html }}
                    <span style="font-size:{{ text_sz }}px; color:{{ text_col }}; line-height:1.3;">
                      {{- t | default: 'Details' -}}
                    </span>
                    <span class="caret-icon" aria-hidden="true">
                      <svg class="icon-accordion" viewBox="0 0 20 20" width="20" height="20" role="presentation" focusable="false" aria-hidden="true">
                        <path fill-rule="evenodd"
                          d="M7.5 5.5a.75.75 0 011.06 0l4 4a.75.75 0 010 1.06l-4 4a.75.75 0 11-1.06-1.06L10.44 10 7.5 7.06a.75.75 0 010-1.56z"
                          clip-rule="evenodd" />
                      </svg>
                    </span>
                  </button>
                  <div class="panel-body">
                    <div id="faq-{{ uid }}" class="collapse" data-parent="#Accordion-{{ section.id }}">
                      <div class="item-content rte" style="padding: 0 0 20px 0; color: {{ text_col }};">{{ c_html }}</div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {#-----------------------------------#}
          {# 2) THEME EDITOR ITEMS (t1..t10)  #}
          {#   — Rendered AFTER custom fields #}
          {#-----------------------------------#}
          {%- assign retina = icon_px | times: 2 -%}
          {%- for i in (1..10) -%}
            {%- assign t_id = 't'     | append: i -%}
            {%- assign c_id = 'c'     | append: i -%}
            {%- assign i_id = 'icon'  | append: i -%}
            {%- assign m_id = 'image' | append: i -%}

            {%- assign t  = block.settings[t_id] | default: '' | strip -%}
            {%- assign cH = block.settings[c_id] | default: '' -%}  {# richtext already HTML #}
            {%- assign ic = block.settings[i_id] | default: '' | strip -%}
            {%- assign im = block.settings[m_id] -%}

            {%- assign has_any = false -%}
            {%- if t != '' or cH != '' -%}{%- assign has_any = true -%}{%- endif -%}

            {%- if has_any -%}
              {%- comment -%} Icon first; if none, try image {%- endcomment -%}
              {%- assign icon_html = '' -%}
              {%- if ic != '' -%}
                {%- assign norm = ic | downcase | remove: 'u+' | remove: '0x' | remove: '&#x' | remove: '&#' | remove: ';' | strip -%}
                {%- assign HEX = norm | upcase -%}
                {%- assign hex_test = HEX
                  | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4'
                  | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
                  | remove: 'A' | remove: 'B' | remove: 'C' | remove: 'D' | remove: 'E' | remove: 'F'
                -%}
                {%- assign looks_hex = false -%}
                {%- if HEX != '' and hex_test == '' -%}{%- assign looks_hex = true -%}{%- endif -%}

                {%- capture icon_html -%}
                  <span class="faq-title-icon" aria-hidden="true"
                        style="font-size:{{ icon_px }}px; color:{{ icon_col }}; line-height:1; display:inline-block; margin-right:8px;">
                    {%- if looks_hex -%}{{ '&#x' | append: HEX | append: ';' }}{%- else -%}{{ ic }}{%- endif -%}
                  </span>
                {%- endcapture -%}
              {%- elsif im != blank -%}
                {%- assign img1x = im | image_url: width: icon_px -%}
                {%- assign img2x = im | image_url: width: retina -%}
                {%- capture icon_html -%}
                  <img src="{{ img2x | escape }}"
                       srcset="{{ img1x | escape }} 1x, {{ img2x | escape }} 2x"
                       alt=""
                       width="{{ icon_px }}" height="{{ icon_px }}"
                       style="display:inline-block; width:{{ icon_px }}px; height:{{ icon_px }}px; object-fit:contain; margin-right:8px;">
                {%- endcapture -%}
              {%- endif -%}

              {%- assign uid = section.id | append: '-u-' | append: block.id | append: '-te-' | append: i -%}
              <div class="faqs-main" style="font-size: {{ text_sz }}px;">
                <div class="panel-group">
                  <button class="panel-header" type="button" aria-controls="faq-{{ uid }}" aria-expanded="false" data-target="#faq-{{ uid }}">
                    {{ icon_html }}
                    <span style="font-size:{{ text_sz }}px; color:{{ text_col }}; line-height:1.3;">
                      {{- t | default: 'Details' -}}
                    </span>
                    <span class="caret-icon" aria-hidden="true">
                      <svg class="icon-accordion" viewBox="0 0 20 20" width="20" height="20" role="presentation" focusable="false" aria-hidden="true">
                        <path fill-rule="evenodd"
                          d="M7.5 5.5a.75.75 0 011.06 0l4 4a.75.75 0 010 1.06l-4 4a.75.75 0 11-1.06-1.06L10.44 10 7.5 7.06a.75.75 0 010-1.56z"
                          clip-rule="evenodd" />
                      </svg>
                    </span>
                  </button>

                  <div class="panel-body">
                    <div id="faq-{{ uid }}" class="collapse" data-parent="#Accordion-{{ section.id }}">
                      <div class="item-content rte" style="padding: 0 0 20px 0; color: {{ text_col }};">{{ cH }}</div>
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

        {%- endcapture -%}

        {%- assign rows_trim = all_rows | strip -%}
        {%- if rows_trim != '' -%}
          {{ all_rows }}
        {%- endif -%}

      {%- endif -%}
    </div>

    <script>
      (function () {
        var root = document.getElementById('Accordion-{{ section.id | append: forloop.index }}');
        if (!root) return;

        // Initialize max-heights for smooth animation
        root.querySelectorAll('.collapse').forEach(function (el) {
          el.style.maxHeight = el.classList.contains('show') ? el.scrollHeight + 'px' : '0px';
        });

        function openPanel(panel, header) {
          var main = header.closest('.faqs-main');
          panel.classList.add('show');
          panel.style.maxHeight = panel.scrollHeight + 'px';
          if (main) main.classList.add('active');
        }

        function closePanel(panel, header) {
          var main = header.closest('.faqs-main');
          panel.style.maxHeight = panel.scrollHeight + 'px';
          requestAnimationFrame(function () {
            panel.style.maxHeight = '0px';
            panel.addEventListener('transitionend', function handler() {
              panel.classList.remove('show');
              if (main) main.classList.remove('active');
              panel.removeEventListener('transitionend', handler);
            });
          });
        }

        function closeSiblings(except) {
          root.querySelectorAll('.collapse.show').forEach(function (openEl) {
            if (openEl !== except) {
              var head = root.querySelector('.panel-header[data-target="#' + openEl.id + '"]');
              closePanel(openEl, head);
              if (head) head.setAttribute('aria-expanded', 'false');
            }
          });
        }

        root.addEventListener('click', function (e) {
          var btn = e.target.closest('.panel-header');
          if (!btn) return;

          var targetSel = btn.getAttribute('data-target');
          var panel = root.querySelector(targetSel);
          if (!panel) return;

          var isOpen = panel.classList.contains('show');
          if (isOpen) {
            btn.setAttribute('aria-expanded', 'false');
            closePanel(panel, btn);
          } else {
            closeSiblings(panel);
            btn.setAttribute('aria-expanded', 'true');
            openPanel(panel, btn);
          }
        });

        document.addEventListener('shopify:section:load', function (e) {
          if (e.detail && e.detail.sectionId === '{{ section.id }}') {
            var newRoot = document.getElementById('Accordion-{{ section.id | append: forloop.index }}');
            if (!newRoot) return;
            newRoot.querySelectorAll('.collapse').forEach(function (el) {
              el.style.maxHeight = el.classList.contains('show') ? el.scrollHeight + 'px' : '0px';
            });
          }
        });
      })();
    </script>
  {% endif %}
{% endfor %}
