{%- comment -%}
  BAH – Product Bullet Points (dynamic keys, hard-coded check icon)
  Product metafield (optional): custom.product_bullet_points → metaobject reference
    • Metaobject typed fields (optional): is_show:Boolean, bullet_point_1..bullet_point_5
  Block settings (your schema):
    • is_show, bullet_point_1..bullet_point_5
    • emoji_size, emoji_color, body_font_size, text_color, text_highlighted_color
    • display_layout ('row' = 1 col, 'column' = 2 cols), column_gap
    • padding_top, padding_bottom
{%- endcomment -%}

{% for block in section.blocks %}
  {% if block.type == 'bah-product-bullet-points' %}
    {%- assign mf = product.metafields.custom.product_bullet_points -%}
    {%- assign mo = nil -%}
    {%- if mf != blank and mf.type contains 'metaobject' -%}
      {%- assign mo = mf.value -%}
    {%- endif -%}

    {%- comment -%} Show/Hide: product first, then block fallback {%- endcomment -%}
    {%- assign is_show = nil -%}
    {%- if mo and mo.is_show != nil -%}{%- assign is_show = mo.is_show -%}{%- endif -%}
    {%- if is_show == nil -%}{%- assign is_show = block.settings.is_show -%}{%- endif -%}

    {%- assign base_key = 'bullet_point_' -%}
    {%- assign icon_char = '✔' -%}

    {%- assign icon_px  = block.settings.emoji_size       | default: 18 -%}
    {%- assign icon_col = block.settings.emoji_color      | default: '#000000' -%}
    {%- assign text_sz  = block.settings.body_font_size   | default: 14 -%}
    {%- assign text_col = block.settings.text_color       | default: '#505157' -%}
    {%- assign hl_col   = block.settings.text_highlighted_color | default: text_col -%}
    {%- assign layout   = block.settings.display_layout   | default: 'row' -%}
    {%- assign gap_px   = block.settings.column_gap       | default: 8 -%}
    {%- assign pad_t    = block.settings.padding_top      | default: 0 -%}
    {%- assign pad_b    = block.settings.padding_bottom   | default: 0 -%}

    {%- comment -%} Build bullet <li>s (prefer product metaobject → fallback to block settings) {%- endcomment -%}
    {%- capture bullets -%}
      {%- for i in (1..5) -%}
        {%- assign key = base_key | append: i -%}
        {%- assign txt = '' -%}

        {%- if mo -%}
          {%- case i -%}
            {%- when 1 -%}{%- assign txt = mo.bullet_point_1 -%}
            {%- when 2 -%}{%- assign txt = mo.bullet_point_2 -%}
            {%- when 3 -%}{%- assign txt = mo.bullet_point_3 -%}
            {%- when 4 -%}{%- assign txt = mo.bullet_point_4 -%}
            {%- when 5 -%}{%- assign txt = mo.bullet_point_5 -%}
          {%- endcase -%}
        {%- endif -%}

        {%- if txt == blank -%}
          {%- assign txt = block.settings[key] -%}
        {%- endif -%}

        {%- if txt != blank -%}
          <li class="bah-bp__item" style="display:flex;align-items:center;gap:8px;{% if layout == 'row' %}margin-bottom:{{ gap_px }}px;{% endif %}">
            <span aria-hidden="true" class="bah-bp__icon" style="font-size:{{ icon_px }}px;color:{{ icon_col }};line-height:1;display:inline-block;">{{ icon_char }}</span>
            <span class="bah-bp__text" style="font-size:{{ text_sz }}px;color:{{ text_col }};line-height:1.3;">{{ txt | newline_to_br }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- assign has_bullets = bullets | strip -%}

    {%- if is_show == true and has_bullets != '' -%}
      <ul
        class="bah-product-bullet-points"
        style="
          margin:0;
          padding: {{ pad_t }}px 0 {{ pad_b }}px 0;
          list-style:none;
          {% if layout == 'column' %}
            display:grid;
            grid-template-columns: 1fr 1fr;
            column-gap: {{ gap_px }}px;
            row-gap: {{ gap_px }}px;
          {% else %}
            display:flex;
            flex-direction:column;
          {% endif %}
        "
      >
        {{ bullets }}
      </ul>

      {%- comment -%} Highlight color for <strong>/<b> inside bullets {%- endcomment -%}
      <style>
        .bah-product-bullet-points .bah-bp__text strong,
        .bah-product-bullet-points .bah-bp__text b { color: {{ hl_col }}; }
      </style>
    {%- endif -%}
  {% endif %}
{% endfor %}
